# Copie este archivo como .env para sobrescribir los valores por defecto de docker-compose.yml
DB_USER=canchaya
DB_PASSWORD=canchaya
# Mínimo 32 caracteres. Genere uno propio, por ejemplo: openssl rand -base64 48
JWT_SECRET=canchaya-clave-de-desarrollo-cambiar-en-produccion-2026
# Vigencia del token en milisegundos (24 horas)
JWT_EXPIRATION=86400000
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
